# ==========================================
# PhishGuard Backend - Render Production Environment
# ==========================================
# Copy these values into Render Dashboard -> Environment -> Environment Variables

# Node Environment & Server Port
NODE_ENV=production
PORT=8080

# CORS Allowed Origin (Set this to your Vercel frontend URL, comma-separated if multiple)
# e.g., https://phishguard.vercel.app or https://your-project-name.vercel.app
ALLOWED_ORIGIN=https://your-frontend-app.vercel.app

# AI Providers (Provide at least one API key)
# 1. Anthropic Claude (Primary recommended provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 2. Google Gemini (Alternative / Fallback provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# 3. Groq (Ultra-fast inference provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 4. OpenRouter (Multi-model routing gateway)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_SITE_URL=https://your-frontend-app.vercel.app
OPENROUTER_SITE_NAME=PhishGuard

# 5. OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Default AI Provider selection: auto | anthropic | gemini | groq | openrouter | openai
DEFAULT_AI_PROVIDER=auto

# Supabase (PostgreSQL & Database Authentication)
# Note: Keep the SERVICE_ROLE_KEY confidential; it must never be exposed to the frontend!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
