# ==========================================
# PhishGuard Frontend - Vercel Production Environment
# ==========================================
# Copy these values into Vercel Dashboard -> Project Settings -> Environment Variables

# Backend API URL (Your deployed Render service URL without trailing slash)
# e.g., https://phishguard-backend.onrender.com
VITE_BACKEND_URL=https://your-backend-service.onrender.com

# Supabase Public Keys (Safe to be bundled in frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
